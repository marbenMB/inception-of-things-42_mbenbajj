Vagrant.configure("2") do |config|
  config.vm.box = "bento/ubuntu-24.04"
  config.vm.box_version = "202510.26.0"

config.vm.provider "virtualbox" do |vb|
      vb.cpus   = 1
      vb.memory = 2048
end

  config.vm.define "lab-server" do |server|
    server.vm.hostname = "lab-server"
    server.vm.network "private_network", ip: "192.168.56.120"
    server.vm.provider "virtualbox" do |vb|
      vb.name = "lab-server"
    end
  end

  config.vm.define "lab-worker" do |worker|
    worker.vm.hostname = "lab-worker"
    worker.vm.network "private_network", ip: "192.168.56.121"
    worker.vm.provider "virtualbox" do |vb|
      vb.name = "lab-worker"
    end
  end
end